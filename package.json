{
  "name": "dex-connector-ui-sdk",
  "version": "0.2.1",
  "description": "Harness-agnostic agent capability SDK: turn raw tool-call results (builtin tools + MCP connectors) into structured UI descriptors. Pure data \u2014 the host renders.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "agent",
    "llm",
    "mcp",
    "tool-results",
    "generative-ui",
    "connector",
    "extractors"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
